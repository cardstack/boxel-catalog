            "id": "hero",
            "label": "Your move · Stalker {m1} · Witch {m2} · Reaper {m3}",
            "seat": "you"
          },
          {
            "id": "monsters",
            "label": "The monsters strike",
            "seat": "bot"
          }
        ],
        "actions": [
          {
            "id": "strike1",
            "label": "Strike the Hollow Stalker",
            "phase": "hero",
            "when": "m1 > 0",
            "effect": [
              {
                "roll": "d6h#1",
                "as": "a"
              },
              {
                "set": "m1",
                "to": "max(0, m1 - (a + rules.atk))"
              },
              {
                "log": "You roll {a} and hit the Hollow Stalker for {a + rules.atk}; it has {m1} HP left"
              },
              {
                "phase": "monsters"
              }
            ],
            "gesture": {
              "click": "mon1"
            }
          },
          {
            "id": "strike2",
            "label": "Strike the Gloom Witch",
            "phase": "hero",
            "when": "m2 > 0",
            "effect": [
              {
                "roll": "d6h#1",
                "as": "a"
              },
              {
                "set": "m2",
                "to": "max(0, m2 - (a + rules.atk))"
              },
              {
                "log": "You roll {a} and hit the Gloom Witch for {a + rules.atk}; she has {m2} HP left"
              },
              {
                "phase": "monsters"
              }
            ],
            "gesture": {
              "click": "mon2"
            }
          },
          {
            "id": "strike3",
            "label": "Strike the Mask Reaper",
            "phase": "hero",
            "when": "m3 > 0",
            "effect": [
              {
                "roll": "d6h#1",
                "as": "a"
              },
              {
                "set": "m3",
                "to": "max(0, m3 - (a + rules.atk))"
              },
              {
                "log": "You roll {a} and hit the Mask Reaper for {a + rules.atk}; it has {m3} HP left"
              },
              {
                "phase": "monsters"
              }
            ],
            "gesture": {
              "click": "mon3"
            }
          },
          {
            "id": "monstersStrike",
            "label": "Monsters strike",
            "phase": "monsters",
            "effect": [
              {
                "roll": "d6m#1",
                "as": "x"
              },
              {
                "roll": "d6m#2",
                "as": "y"
              },
              {
                "roll": "d6m#3",
                "as": "z"
              },
              {
                "if": "m1 > 0",
                "then": [
                  {
                    "resource": {
                      "seat": "you",
                      "name": "hp",
                      "add": "-max(0, x - 1)"
                    }
                  }
                ]
              },
              {
                "if": "m2 > 0",
                "then": [
                  {
                    "resource": {
                      "seat": "you",
                      "name": "hp",
                      "add": "-max(0, y - 1)"
                    }
                  }
                ]
              },
              {
                "if": "m3 > 0",
                "then": [
                  {
                    "resource": {
                      "seat": "you",
                      "name": "hp",
                      "add": "-max(0, z - 1)"
                    }
                  }
                ]
              },
              {
                "log": "Stalker rolls {x}, Witch {y}, Reaper {z}: the hero takes the damage after armour (1 off each hit)"
              },
              {
                "phase": "hero"
              }
            ],
            "gesture": {
              "click": "hero"
            }
          }
        ],
        "winConditions": [
          {
            "when": "res('you', 'hp') <= 0",
            "winner": "'bot'",
            "text": "The hero falls. The monsters win"
          },
          {
            "when": "m1 + m2 + m3 == 0",
            "winner": "'you'",
            "text": "All three monsters fall. You win"
          }
        ]
