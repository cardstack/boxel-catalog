          },
          {
            "id": "hand:you",
            "kind": "spread",
            "label": "You",
            "badge": "handTotal('you')",
            "owner": "you",
            "x": 30,
            "y": 29,
            "w": 40,
            "h": 20,
            "partW": 9.5,
            "narrow": {
              "x": 10,
              "y": 38,
              "w": 80,
              "h": 30,
              "partW": 19
            },
            "name": "your hand"
          },
          {
            "id": "bet",
            "kind": "pot",
            "label": "Bet",
            "owner": "you",
            "x": 41,
            "y": 51.5,
            "w": 18,
            "h": 9.5,
            "narrow": {
              "x": 32,
              "y": 72,
              "w": 36,
              "h": 14
            }
          },
          {
            "id": "rack",
            "kind": "pot",
            "hidden": true
          }
        ],
        "meters": [
          {
            "var": "bet",
            "label": "",
            "look": "chips",
            "x": 50,
            "y": 55.5,
            "narrow": {
              "x": 50,
              "y": 78.5
            }
          },
          {
            "seat": "you",
            "resource": "chips",
            "label": "Your chips",
            "look": "chips",
            "x": 80,
            "y": 53,
            "narrow": {
              "x": 84,
              "y": 80
            }
          }
        ]
      },
      "ruleset": {
        "options": {
          "hitSoft17": false,
          "blackjackPays": 1.5,
          "reshuffleBelow": 30,
          "minBet": 10,
          "maxBet": 100,
          "startingChips": 200
        },
        "defines": {
          "handTotal": {
            "params": [
              "s"
            ],
            "expr": "best('hand:' + s, 21)"
          },
          "isSoft": {
            "params": [
              "s"
            ],
            "expr": "soft('hand:' + s, 21)"
          },
          "busted": {
            "params": [
              "s"
            ],
            "expr": "handTotal(s) > 21"
          },
          "natural": {
            "params": [
              "s"
            ],
            "expr": "count('hand:' + s) == 2 && handTotal(s) == 21"
          },
          "shown": {
            "params": [
              "s"
            ],
            "expr": "faceUp('hand:' + s) == count('hand:' + s) ? handTotal(s) : ''"
          }
        },
        "setup": [
          {
            "shuffle": "shoe"
          },
          {
            "set": "bet",
            "to": 0
          },
          {
            "set": "hand",
            "to": 0
          }
        ],
        "turnOrder": [
          "you",
          "dealer"
        ],
        "phases": [
          {
            "id": "bet",
            "label": "Place your bet",
            "seat": "you",
            "onEnter": [
              {
                "if": "count('shoe') < rules.reshuffleBelow",
                "then": [
                  {
                    "collect": {
                      "from": [
                        "discard"
                      ],
                      "to": "shoe",
                      "facing": "down"
                    }
                  },
                  {
                    "shuffle": "shoe"
                  },
                  {
                    "log": "the shoe is reshuffled"
                  }
                ]
              }
            ]
          },
          {
            "id": "player",
            "label": "Hit or stand?",
            "seat": "you"
          },
          {
            "id": "dealer",
            "label": "Dealer plays",
            "seat": "dealer",
            "onEnter": [
              {
                "flip": {
                  "zone": "hand:dealer",
                  "facing": "up"
                }
              }
            ]
          },
          {
            "id": "settle",
            "label": "{outcome}",
            "seat": "you",
            "onEnter": [
              {
                "flip": {
                  "zone": "hand:dealer",
                  "facing": "up"
                }
              },
              {
                "if": "busted('you')",
                "then": [
                  {
                    "set": "outcome",
                    "to": "'Bust. The dealer takes ' + bet"
                  }
                ],
                "else": [
                  {
                    "if": "natural('you') && !natural('dealer')",
                    "then": [
                      {
                        "resource": {
                          "seat": "you",
                          "name": "chips",
                          "add": "bet + floor(bet * rules.blackjackPays)"
                        }
                      },
                      {
                        "set": "outcome",
                        "to": "'Blackjack! You win ' + floor(bet * rules.blackjackPays)"
                      }
                    ],
                    "else": [
                      {
                        "if": "busted('dealer') || handTotal('you') > handTotal('dealer')",
                        "then": [
                          {
                            "resource": {
                              "seat": "you",
                              "name": "chips",
                              "add": "bet * 2"
                            }
                          },
                          {
                            "set": "outcome",
                            "to": "(busted('dealer') ? 'Dealer busts. ' : handTotal('you') + ' beats ' + handTotal('dealer') + '. ') + 'You win ' + bet"
                          }
                        ],
                        "else": [
                          {
                            "if": "handTotal('you') == handTotal('dealer')",
                            "then": [
                              {
                                "resource": {
                                  "seat": "you",
                                  "name": "chips",
                                  "add": "bet"
                                }
                              },
                              {
                                "set": "outcome",
                                "to": "'Push at ' + handTotal('you') + '. Your bet comes back'"
                              }
                            ],
                            "else": [
                              {
                                "set": "outcome",
                                "to": "handTotal('dealer') + ' beats ' + handTotal('you') + '. The dealer takes ' + bet"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "log": "{outcome}"
              },
              {
                "set": "bet",
                "to": 0
              },
              {
                "if": "res('you', 'chips') < rules.minBet",
                "then": [
                  {
                    "end": {
                      "winner": "'dealer'",
                      "text": "Out of chips after {hand} hand{hand == 1 ? '' : 's'}"
                    }
                  }
                ]
              }
            ]
          }
        ],
        "actions": [
          {
            "id": "chip",
            "label": "+{args.amount}",
            "phase": "bet",
            "options": {
              "amount": [
                1,
                5,
                10,
                25,
                100
              ]
            },
            "when": "res('you', 'chips') >= args.amount && bet + args.amount <= rules.maxBet",
