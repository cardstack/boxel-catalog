{
  "data": {
    "type": "card",
    "attributes": {
      "rules": [
        {
          "targetType": {
            "module": "../../7af9aa-blog-app/blog-post",
            "name": "BlogPost"
          },
          "grants": [
            {
              "operation": "read",
              "where": "actor() == \"anonymous\" and .published == true"
            },
            {
              "operation": "read"
            }
          ]
        },
        {
          "targetType": {
            "module": "../../7af9aa-blog-app/blog-category",
            "name": "BlogCategory"
          },
          "grants": [
            {
              "operation": "read",
              "where": "actor() == \"anonymous\""
            },
            {
              "operation": "read"
            },
            {
              "operation": "query",
              "where": "actor() == \"anonymous\""
            },
            {
              "operation": "query"
            }
          ]
        }
      ],
      "cardInfo": {
        "name": "Blog publishing",
        "summary": "Visitors open published posts and open and search every category; any signed-in user also reads drafts and searches categories."
      }
    },
    "meta": {
      "adoptsFrom": {
        "module": "../realm-policy",
        "name": "RealmPolicy"
      }
    }
  }
}
